    "jev-verify": "bin/jev-verify.mjs"
  },
  "scripts": {
    "build:macos": "node scripts/build-macos.mjs",
    "test:verification": "node --test test/verification.test.mjs test/verification-enforcement.test.mjs test/verification-hook.test.mjs test/tool-decisions.test.mjs test/decision-hook.test.mjs"
